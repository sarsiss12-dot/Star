# STARS MP.1 relay ortam değişkenleri (örnek). Bu dosyada GİZLİ ANAHTAR YOKTUR;
# relay'in sır gerektiren bir ayarı yok (oda/host anahtarları bellekte üretilir).
# Kopyala, alan adını düzelt, platformun "environment variables" bölümüne gir.
MP1_BIND=0.0.0.0
# Platform PORT veriyorsa boş bırak; yoksa:
# MP1_PORT=8080
# TLS önündeki vekilde/platformda bitiyorsa:
MP1_TRUST_PROXY=1
# Oyunun herkese açık https adresi (virgülle birden fazla):
MP1_ORIGINS=https://stars.ornek-alan.tr
# İsteğe bağlı sınırlar (varsayılanlar gösterildi):
# MP1_MAX_ROOMS=200
# MP1_ROOM_TTL_MS=43200000
# MP1_HOST_GRACE_MS=600000
# MP1_CREATES_PER_MIN=10
# MP1_PING_MS=25000
# Doğrudan TLS (vekil yoksa) — sertifika dosya YOLLARI, içerik değil:
# MP1_TLS_CERT=/etc/stars/fullchain.pem
# MP1_TLS_KEY=/etc/stars/privkey.pem
# ÜRETİMDE AÇMA: MP1_DEV=1 (relay reddeder)
