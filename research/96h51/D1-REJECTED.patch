+/* 96H.5.1: complete the missing automatic doctrine choices without
+   replacing government/species or drawing from either live RNG stream.
+   Legacy archetypes keep their inferred behavior and research identity.
+   Existing defaults are twice as common as the newly reachable sibling. */
+const AI_DOCTRINE_CHOICES = Object.freeze({
+  teknokrasi: Object.freeze([['teknokrasi',1]]),
+  meclis: Object.freeze([['pasifist',2],['teokrasi',1]]),
+  lonca: Object.freeze([['tuccar',2],['kriminal',1]])
+});
+function assignNewAIDoctrine(e){
+  if (!e || !e.ai || e.wild || e.crisisSide || e.mizac || e.persLock) return;
+  const choices=(AI_DOCTRINE_CHOICES[e.race]||[])
+    .filter(([key,weight])=>weight>0&&PERSONAS[key]&&DOCTRINE_RACE[key]===e.race);
+  if (!choices.length) return;
+  const random=mulberry32(identityHash('ai-doctrine96h51:'+G.seed+':'+e.id));
+  let at=random()*choices.reduce((sum,[,weight])=>sum+weight,0);
+  let key=choices[choices.length-1][0];
+  for (const [candidate,weight] of choices){at-=weight;if(at<0){key=candidate;break;}}
+  e.mizac=key;
+  e._pers=key;
+  delete e._persAt;
+  e._prof=null;
+}
